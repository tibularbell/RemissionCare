{
  "entities": {
    "PatientProfile": {
      "title": "PatientProfile",
      "description": "Core clinical DM Remission profile for a patient without PII.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "icd10Code": {
          "type": "string",
          "enum": ["E10", "E11", "E12", "E13", "E14"],
          "maxLength": 10
        },
        "typeArea": {
          "type": "number",
          "description": "MOH 43-file Type Area code (1-5)"
        },
        "remissionStage": {
          "type": "string",
          "enum": ["active_dm", "improving", "in_remission", "sustained_remission"],
          "maxLength": 32
        },
        "activityCode120": {
          "type": "boolean",
          "description": "Special PP DM Remission activity code 120 eligibility"
        },
        "targetHba1c": {
          "type": "number"
        },
        "medsFreeMonths": {
          "type": "number"
        },
        "clinicName": {
          "type": "string",
          "maxLength": 160
        },
        "attendingDoctor": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "icd10Code",
        "typeArea",
        "remissionStage",
        "activityCode120",
        "targetHba1c",
        "medsFreeMonths",
        "clinicName",
        "attendingDoctor",
        "createdAt",
        "updatedAt"
      ]
    },
    "PatientPrivatePii": {
      "title": "PatientPrivatePii",
      "description": "Strictly isolated personally identifiable information for the patient.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cidMasked": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "birthDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "insuranceScheme": {
          "type": "string",
          "enum": ["UCS", "SSS", "CSMBS", "SelfPay", "Other"],
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "cidMasked",
        "fullName",
        "birthDate",
        "phone",
        "email",
        "insuranceScheme",
        "updatedAt"
      ]
    },
    "Hba1cRecord": {
      "title": "Hba1cRecord",
      "description": "Blood HbA1c lab measurement with LOINC and 43-file audit metadata.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "value": {
          "type": "number"
        },
        "testDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "loincCode": {
          "type": "string",
          "maxLength": 20
        },
        "icd10Code": {
          "type": "string",
          "enum": ["E10", "E11", "E12", "E13", "E14"],
          "maxLength": 10
        },
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "activityCode": {
          "type": "string",
          "enum": ["120", "standard"],
          "maxLength": 20
        },
        "eClaimStatus": {
          "type": "string",
          "enum": ["synced", "pending", "rep_error", "late_submission"],
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "value",
        "testDate",
        "loincCode",
        "icd10Code",
        "facilityName",
        "activityCode",
        "eClaimStatus",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeviceReading": {
      "title": "DeviceReading",
      "description": "Connected medical device telemetry reading (BGM, CGM, BP, scale).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceType": {
          "type": "string",
          "enum": ["glucometer", "cgm", "bp_monitor", "smart_scale"],
          "maxLength": 32
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "glucoseMgDl": {
          "type": "number"
        },
        "systolic": {
          "type": "number"
        },
        "diastolic": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "mealContext": {
          "type": "string",
          "enum": ["fasting", "pre_meal", "post_meal", "bedtime"],
          "maxLength": 24
        },
        "recordedAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "deviceType",
        "deviceName",
        "glucoseMgDl",
        "systolic",
        "diastolic",
        "weightKg",
        "mealContext",
        "recordedAt",
        "createdAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Physician follow-up appointment with automated reminder configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "facility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "appointmentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "purpose": {
          "type": "string",
          "enum": ["hba1c_followup", "remission_eval", "nutrition_consult", "telemed"],
          "maxLength": 32
        },
        "reminderEnabled": {
          "type": "boolean"
        },
        "reminderDaysBefore": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"],
          "maxLength": 24
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "doctorName",
        "department",
        "facility",
        "appointmentDate",
        "purpose",
        "reminderEnabled",
        "reminderDaysBefore",
        "status",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "DoctorRecommendation": {
      "title": "DoctorRecommendation",
      "description": "Personalized clinical recommendation linked to patient HbA1c trend analysis.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["nutrition", "exercise", "medication", "lab_schedule", "remission_plan"],
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "advice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "priority": {
          "type": "string",
          "enum": ["routine", "attention", "urgent"],
          "maxLength": 20
        },
        "acknowledged": {
          "type": "boolean"
        },
        "issuedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "doctorName",
        "category",
        "title",
        "advice",
        "priority",
        "acknowledged",
        "issuedDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProgramParticipant": {
      "title": "ProgramParticipant",
      "description": "Patient enrolled in the RemissionCare DM Remission activity program with longitudinal HbA1c and medication-free progress tracking (no PII).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "icd10Code": {
          "type": "string",
          "enum": ["E10", "E11", "E12", "E13", "E14"],
          "maxLength": 10
        },
        "typeArea": {
          "type": "number",
          "description": "MOH 43-file Type Area code (1-5)"
        },
        "activityCode": {
          "type": "string",
          "enum": ["120", "standard"],
          "maxLength": 20
        },
        "enrolledDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "baselineHba1c": {
          "type": "number"
        },
        "currentHba1c": {
          "type": "number"
        },
        "targetHba1c": {
          "type": "number"
        },
        "medsFreeMonths": {
          "type": "number"
        },
        "remissionStage": {
          "type": "string",
          "enum": ["active_dm", "improving", "in_remission", "sustained_remission"],
          "maxLength": 32
        },
        "lastCheckupDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "nextFollowupDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "clinicName": {
          "type": "string",
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "participantCode",
        "displayName",
        "icd10Code",
        "typeArea",
        "activityCode",
        "enrolledDate",
        "baselineHba1c",
        "currentHba1c",
        "targetHba1c",
        "medsFreeMonths",
        "remissionStage",
        "lastCheckupDate",
        "nextFollowupDate",
        "clinicName",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientProfile" },
      "description": "Patient clinical profile and DM Remission progress."
    },
    "/patients/{patientId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PatientPrivatePii" },
      "description": "Private isolated PII document (docId: pii)."
    },
    "/patients/{patientId}/hba1cRecords/{recordId}": {
      "schema": { "$ref": "#/entities/Hba1cRecord" },
      "description": "Patient HbA1c blood test results and LOINC/43-file validation state."
    },
    "/patients/{patientId}/deviceReadings/{readingId}": {
      "schema": { "$ref": "#/entities/DeviceReading" },
      "description": "Connected medical device telemetry logs."
    },
    "/patients/{patientId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Physician appointments and automated reminder preferences."
    },
    "/patients/{patientId}/recommendations/{recId}": {
      "schema": { "$ref": "#/entities/DoctorRecommendation" },
      "description": "Clinical guidance and doctor recommendations for DM Remission."
    },
    "/patients/{patientId}/programParticipants/{participantId}": {
      "schema": { "$ref": "#/entities/ProgramParticipant" },
      "description": "Patients enrolled in RemissionCare cohort tracking and Special PP 120 progress."
    }
  }
}
